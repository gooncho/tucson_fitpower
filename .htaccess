# Archivos y carpetas ocultos (.env, .git, .htaccess...)
    RedirectMatch 404 /\.
# Código y configuración del backend: PHP los usa por dentro, nadie los pide por URL
    RedirectMatch 404 ^/api/(config|src)/
# Archivos de base de datos, Docker y documentación
    RedirectMatch 404 \.(sql|yml|yaml|md|log|bak)$
    RedirectMatch 404 ^/Dockerfile$

<IfModule mod_rewrite.c> 
    RewriteEngine On

    # ====================================================
    # 1. TRÁFICO DE LA API (Los repartidores)
    # ====================================================
    # Si la URL solicitada empieza con "api/"...
    RewriteCond %{REQUEST_URI} ^/api/
    # ...y no es un archivo físico que exista (como una imagen)...
    RewriteCond %{REQUEST_FILENAME} !-f
    # ...y tampoco es una carpeta real...
    RewriteCond %{REQUEST_FILENAME} !-d
    # ...entonces, manda TODO al index.php de la carpeta api.
    RewriteRule ^api/(.*)$ /api/index.php [L,QSA]


    # ====================================================
    # 2. TRÁFICO DEL FRONTEND (Los clientes)
    # ====================================================
    # Redirige físicamente a la carpeta front cuando entran a la raíz
    RewriteRule ^$ /front/index.html [R=301,L]
</IfModule>