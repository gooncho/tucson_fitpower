# Archivos que nunca se muestran
RedirectMatch 404 /\.
RedirectMatch 404 ^/api/(config|src)/
RedirectMatch 404 \.(sql|yml|yaml|md|log|bak)$
RedirectMatch 404 ^/Dockerfile$

<IfModule mod_rewrite.c>
    RewriteEngine On

    # API: igual que antes
    RewriteCond %{REQUEST_URI} ^/api/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/(.*)$ /api/index.php [L,QSA]

    # --- A) Si alguien entra con una dirección vieja, se la cambiamos por la corta ---
    # /front/dist/Paginas/roles/socio/Rutinas.html  ->  /socio/Rutinas
    # /socio/Rutinas.html                            ->  /socio/Rutinas
    RewriteCond %{THE_REQUEST} \s/(?:front/dist/Paginas/roles/)?(socio|entrenador|administrador)/(\w+)\.html[\s?]
    RewriteRule ^ /%1/%2 [R=302,L]

    # /front/dist/Paginas/acceso.html  ->  /acceso
    RewriteCond %{THE_REQUEST} \s/(?:front/)?dist/Paginas/acceso\.html[\s?]
    RewriteRule ^ /acceso [R=302,L]

    # /index.html o /front/index.html  ->  /
    RewriteCond %{THE_REQUEST} \s/(?:front/)?index\.html[\s?]
    RewriteRule ^ / [R=302,L]

    # --- B) Direcciones cortas -> archivo real (la barra NO cambia) ---
    RewriteRule ^$ front/index.html [L]
    RewriteRule ^acceso$ front/dist/Paginas/acceso.html [L]
    RewriteRule ^(socio|entrenador|administrador)/(\w+)$ front/dist/Paginas/roles/$1/$2.html [L]

    # --- C) CSS, JS e imágenes ---
    RewriteRule ^(CSS|JS|assets)/(.*)$ front/dist/$1/$2 [L]
    RewriteRule ^dist/(.*)$ front/dist/$1 [L]
</IfModule>